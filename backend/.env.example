# Copy this file to .env and fill in your own values.

# Full PostgreSQL connection string.
# Local example:   postgres://postgres:postgres@localhost:5432/meet_the_chefs
# Render example:  the "External Database URL" from your Render Postgres instance
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE_NAME
# Port the API server listens on.
PORT=4000

# Password for the admin dashboard. Use a LONG random one (12+ characters),
# e.g. run:  node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
# After 10 wrong tries from one address the login is blocked for 15 minutes.
ADMIN_PASSWORD=change-me-to-a-long-random-password

# The frontend's URL, so the API only accepts requests from your site
# (comma-separate more than one, e.g. for localhost + your deployed domain).
FRONTEND_ORIGIN=http://localhost:5173

# The restaurant's time zone. "Today" on the dashboard (daily totals, the hourly chart)
# starts at midnight in THIS zone. Any IANA name works, e.g. Europe/Paris.
RESTAURANT_TZ=Africa/Algiers
